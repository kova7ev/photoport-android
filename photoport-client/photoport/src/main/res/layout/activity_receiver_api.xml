<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical|center_horizontal">

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="register"
        android:id="@+id/registerButton"
        android:layout_gravity="center_horizontal" />

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="couple"
        android:id="@+id/coupleButton"
        android:layout_gravity="center_horizontal" />

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="uncouple"
        android:id="@+id/uncoupleButton"
        android:layout_gravity="center_horizontal" />

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="retrieve provider info"
        android:id="@+id/getProviderButton"
        android:layout_gravity="center_horizontal" />

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="retrieve flickr account"
        android:id="@+id/getFlickrAccount"
        android:layout_gravity="center_horizontal" />
</LinearLayout>